// A small ClementoLang sample exercising the constructs the grammar covers:
// imports, type declarations, generics, lazy functions (`\{ ... }`), eager value
// bindings, `::`-navigable namespaces, `match` patterns, and FFI declarations.

import std::list
import std::io(println eprintln)
import std::stack(swap drop)
import std::boolean(Boolean True False)

type Option<a> {
    None
    Some(value a)
}

defx now ( -> I64)

// An effect declaration. A function performing it annotates it with `!` on the
// output side; `!a` is an effect variable and `!*` the any-effects wildcard.
effect Clock

defx ticks ( -> I64 !Clock)

// Uses the `IO` effect declared in std::io, referenced via the import alias.
def announce (String -> !io::IO) \{ println }

// Lazy functions: referencing the name runs the body.
def or_else (Option<a> a -> a) \{
    swap match {
        Some(value) -> { swap drop }
        None        -> { touch }
    }
}

def map (Option<a> (a -> b) -> Option<b>) \{
    swap match {
        Some(value) -> { value swap apply Some }
        None        -> { drop None }
    }
}

// An eager namespace def: its nested defs are members reached with `::`.
def text {
    def classify (String -> String) \{
        match {
            ""               -> "(empty)"
            "quit"           -> "goodbye"
            "say " ... rest  -> rest
            ['?' ... rest]   -> "a question"
            [first ... tail] -> "unknown"
        }
    }
}

// An eager value binding (a constant).
def answer 42i64

// No `main`: the file's top level is the program. A trailing I32 is the exit code.
"hello" text::classify println
\{ 2i64 * } drop
"done" eprintln
0i32
